# ============================================
# ACLs fuer Mosquitto MQTT Broker
# ============================================

# Bridge Service (vollstaendiger Zugriff)
user bridge_user
topic read sensor/#
topic write sensor/#
topic read status/#
topic write status/#

# Provisioning Service
user provisioner
topic write devices/+/provisioning/response
topic read devices/+/provisioning/request

# Frontend (nur lesen)
user frontend_user
topic read sensor/#
topic read status/#

# Deny all others (alles andere ist verboten)
topic read #
topic write #
