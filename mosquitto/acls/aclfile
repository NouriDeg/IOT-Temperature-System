# ============================================
# ACL REGELN - Least Privilege Prinzip
# ============================================

# Bridge Service (vollständiger Zugriff auf Sensordaten)
user bridge_user
topic read sensor/#
topic write sensor/#
topic read status/#
topic write status/#

# Provisioning Service
user provisioner
topic write devices/+/provisioning/response
topic read devices/+/provisioning/request

# Provisionierte Geräte (dynamisch)
pattern user device_%
topic write sensor/%c/temperature
topic write status/%c/online
topic write status/%c/will
topic read commands/%c/#

# Frontend (nur lesen)
user frontend_user
topic read sensor/#
topic read status/#

# Deny all others
user anonymous
topic deny #