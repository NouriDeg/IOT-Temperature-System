# ============================================
# ACL (Access Control List) - Least-Privilege-Prinzip
# ============================================
# Jeder Benutzer bekommt nur die minimal nötigen Rechte

# ------------------------------------------------------------
# 1. BRIDGE SERVICE (MQTT → PostgreSQL)
# ------------------------------------------------------------
# Die Bridge liest Sensordaten und schreibt sie in die DB
user bridge_user
topic read sensor/#
topic read status/+/online
topic read lwt/+

# ------------------------------------------------------------
# 2. PROVISIONER SERVICE
# ------------------------------------------------------------
# Der Provisioner hört auf Requests und sendet Responses
user provisioner
topic read provisioning/request
topic write provisioning/response
topic read provisioning/status
topic write provisioning/status

# ------------------------------------------------------------
# 3. TEST_DEVICE (Universeller Benutzer für mehrere ESP8266)
# ------------------------------------------------------------
# Alle ESP8266 können diesen Benutzer verwenden
# Er hat volle Rechte (für Entwicklung/Tests)
user test_device
topic read #
topic write #
topic read /#
topic read sensor/#
topic write sensor/temperatur
topic read status/+
topic write status/+
topic read lwt/+
topic write lwt/+
topic read test/#
topic write test/#
topic read commands/+
topic write commands/+

# ------------------------------------------------------------
# 4. DYNAMISCHE GERÄTE (Für viele ESP8266 - sicherer)
# ------------------------------------------------------------
# Jedes Gerät darf nur auf seine eigenen Topics schreiben
# pattern %u = Benutzername wird automatisch eingesetzt
pattern read sensor/#
pattern write sensor/temperatur
pattern read status/%u/online
pattern write status/%u/online
pattern read lwt/%u
pattern write lwt/%u
pattern read commands/%u/ota

# ------------------------------------------------------------
# 5. BEISPIEL: Gerät mit eigenem Benutzer
# ------------------------------------------------------------
# Für mehr Sicherheit: Jedes Gerät bekommt eigenen Benutzer
# user esp8266_01
# topic write sensor/esp8266_01/temperatur
# topic read commands/esp8266_01/+
# topic write status/esp8266_01/online
# topic write lwt/esp8266_01