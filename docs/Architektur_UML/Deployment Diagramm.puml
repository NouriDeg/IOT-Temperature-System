@startuml
!theme plain
title Docker Container Deployment

node "Windows Rechner\n192.168.0.105" as HOST {
    
    rectangle "Docker Engine" as DOCKER #7F8C8D {
        
        folder "Network: iot_network (bridge)" as NET {
            
            component "mqtt_broker\n(Mosquitto)" as MQTT #2ECC71 {
                file "1883 (MQTT)"
                file "8883 (MQTTS)"
                file "mosquitto.conf"
                file "passwd_file"
                file "aclfile"
            }
            
            component "postgres_db\n(PostgreSQL 15)" as DB #2C3E50 {
                file "5432"
                file "postgres_data/"
                file "init.sql"
            }
            
            component "mqtt_bridge\n(Python)" as BRIDGE #2ECC71 {
                file "bridge.py"
                file "requirements.txt"
            }
            
            component "provisioner_service\n(Python)" as PROV #2ECC71 {
                file "app.py"
                file "requirements.txt"
            }
            
            component "api_backend\n(Flask)" as BACKEND #4A90D9 {
                file "5000"
                file "app.py"
            }
            
            component "web_frontend\n(Nginx)" as FRONTEND #4A90D9 {
                file "8080"
                file "index.html"
                file "nginx.conf"
            }
        }
        
        folder "Volumes" as VOL {
            file "mosquitto_data/"
            file "postgres_data/"
        }
        
        folder "Bind Mounts" as BIND {
            file "./mosquitto/config -> /mosquitto/config"
            file "./mosquitto/acls -> /mosquitto/acls"
            file "./certs -> /mosquitto/certs"
            file "./mosquitto/passwd -> /mosquitto/passwd"
        }
    }
    
    actor "ESP8266\n192.168.0.200" as ESP #2C3E50
    actor "Browser" as BROWSER #4A90D9
}

' === Externe Verbindungen ===
ESP --> MQTT : MQTTS (TLS) Port 8883
ESP --> MQTT : Provisioning (temporär) Port 1883

BROWSER --> FRONTEND : HTTP Port 8080
BROWSER --> BACKEND : REST API Port 5000

' === Interne Verbindungen ===
MQTT <--> BRIDGE : MQTT (1883)
MQTT <--> PROV : MQTT (1883)
BRIDGE --> DB : SQL (5432)
BACKEND --> DB : SQL (5432)
FRONTEND --> BACKEND : HTTP

' === Volumes ===
MQTT ..> VOL : persistence
DB ..> VOL : data persistence

' === Bind Mounts ===
MQTT ..> BIND : config

@enduml