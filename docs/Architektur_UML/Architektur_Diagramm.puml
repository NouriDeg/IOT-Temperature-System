@startuml
!theme plain
title IoT Temperature Monitoring System - Architektur

' === Akteure/Extern ===
actor "Benutzer" as User #4A90D9
actor "ESP8266 (MAX6675)" as ESP #2C3E50

' === Docker Container ===
rectangle "DOCKER CONTAINER UMWELT" as Docker #7F8C8D {
    
    rectangle "Mosquitto MQTT Broker" as MQTT #2ECC71 {
        portin "Port 1883" as P1883
        portin "Port 8883" as P8883
    }
    
    rectangle "Provisioner Service" as PROV #2ECC71 {
        port "Provisioning" as PROV_PORT
    }
    
    rectangle "Bridge (Python)" as BRIDGE #2ECC71 {
        port "MQTT→DB" as BRIDGE_PORT
    }
    
    rectangle "Backend (Flask API)" as BACKEND #4A90D9 {
        port "Port 5000" as API_PORT
    }
    
    rectangle "PostgreSQL Datenbank" as DB #2C3E50 {
        port "Port 5432" as DB_PORT
    }
    
    rectangle "Frontend (Nginx)" as FRONTEND #4A90D9 {
        port "Port 8080" as WEB_PORT
    }
}

' === Verbindungen ===
ESP -down-> P8883 : MQTTS (TLS) Port 8883
ESP -down-> PROV_PORT : Provisioning (erstmalig)

P1883 -right-> BRIDGE_PORT : MQTT sensor/#
P1883 -right-> PROV_PORT : MQTT devices/+/provisioning

BRIDGE -down-> DB_PORT : SQL INSERT

BACKEND -down-> DB_PORT : SQL SELECT
FRONTEND -right-> BACKEND : HTTP REST /api/*

User -up-> WEB_PORT : HTTPS Dashboard

' === Notizen ===
note right of ESP
    **ESP8266 Details:**
    SCK an D7 (GPIO13)
    CS an D8 (GPIO15)
    SO an D6 (GPIO12)
    Statische IP: 192.168.0.200
end note

note bottom of MQTT
    **MQTT Topics:**
    sensor/temperatur
    status/{device}/online
    status/{device}/will
    commands/{device}/ota
end note

note bottom of DB
    **PostgreSQL Tabellen:**
    sensor_data
    device_status
    devices (Provisioning)
end note

@enduml